# Optional: choose one AI provider. Keep this file private.
SFW_AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Anthropic (used only when SFW_AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# OpenAI (used only when SFW_AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional private cloud project storage (Supabase; use the anon/public key only)\nSFW_SUPABASE_URL=\nSFW_SUPABASE_ANON_KEY=\n\n# Local project storage path (hosted app filesystems may be ephemeral)
SFW_PROJECT_DIR=data/projects

# Optional remote RTX service. Must be a public HTTPS hostname.
SFW_RTX_BASE_URL=
SFW_RTX_API_TOKEN=
# Optional Cloudflare Access service-token credentials
SFW_RTX_ACCESS_CLIENT_ID=
SFW_RTX_ACCESS_CLIENT_SECRET=

# Shared project library is unsafe on a public multi-user app without authentication.
SFW_ENABLE_SHARED_PROJECT_LIBRARY=false
