{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "science-fair-winner",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "SFWContainer",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./cloudflare/Dockerfile",
          "build_context": "."
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SFW_CONTAINER",
        "class_name": "SFWContainer"
      }
    ]
  },
  "exports": {
    "SFWContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "routes": [
    {
      "pattern": "sfw.wfw.co.ke",
      "custom_domain": true
    }
  ]
}
